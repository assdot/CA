a ) To illustrate the data hazard 
#include<omp.h>
#include<stdio.h>
#include<stdlib.h>
#define ARR_SIZE 25

void bubble_sort(int arr[],int n){
for(int i=0;i<n-1;++i){
for(int j=0;j<n-i-1;++j){
if(arr[j]>arr[j+1]){
int temp=arr[j];
arr[j]=arr[j+1];
arr[j+1]=temp;
}
}
}
}
int main(){
int arr[ARR_SIZE];
#pragma omp parallel for
for(int i=0;i<ARR_SIZE;++i){
arr[i]=random()%100;
}
printf("Array elemenets are:\n");
for(int i=0;i<ARR_SIZE;++i){
printf("%d ",arr[i]);
}
#pragma omp parallel shared(arr)
{
bubble_sort(arr,ARR_SIZE);
}
    
printf("\nSorted elements are: \n");
for(int i=0;i<ARR_SIZE;++i){
printf("%d ",arr[i]);
}
return 0;
}


b ) To eliminate the data hazard 
void bubble_sort(int arr[],int n){
#pragma omp critical
{
for(int i=0;i<n-1;++i){
for(int j=0;j<n-i-1;++j){
if(arr[j]>arr[j+1]){
int temp=arr[j];
arr[j]=arr[j+1];
arr[j+1]=temp;
}
}
}
}
} 


